{
  "name": "immo-verwaltung",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~58.0.22",
    "expo-linking": "~58.0.15",
    "expo-print": "^58.0.8",
    "expo-router": "~58.0.29",
    "expo-sharing": "^58.0.21",
    "expo-status-bar": "~58.0.4",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.11.0",
    "react-native-screens": "^4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/postbuild-web.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build:e2e": "APP_BASE_URL=/ expo export --platform web --output-dir dist-e2e && DIST_DIR=dist-e2e BASE_URL= node scripts/postbuild-web.js",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run build:e2e && npm run test:e2e"
  },
  "private": true
}
